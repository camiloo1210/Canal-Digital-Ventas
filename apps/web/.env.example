# Supabase .env 
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Database url
DATABASE_URL=your_database_url_here

# Lemon Squeezy: keep UI off until Cloud migrations, financial workers and test acceptance pass.
PAYMENTS_CHECKOUT_UI_ENABLED=false
PAYMENTS_ENVIRONMENT=test
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
# Checkout confirmation and receipt buttons return to this app URL.
# Set your public HTTPS domain in production. Vercel system URLs are used if omitted.
PAYMENT_CHECKOUT_RETURN_URL=http://localhost:3000/
# Restricted LOGINs, never the administrative DATABASE_URL. Use TLS and URL-encoded passwords.
PAYMENT_CHECKOUT_DATABASE_URL=
PAYMENT_INGESTION_DATABASE_URL=
# Store, currency and webhook secret reference are provisioned in core.gateway_credentials.
# The webhook secret itself lives in Supabase Vault, not in NEXT_PUBLIC variables.

# Kivi catalog connector (platform-wide, set ONCE by the operator; stores never touch these).
# Public https origin of Kivi, no path. Owners pair their store from Dashboard > Integrations
# with a one-time code, so no per-store variable or URL is ever needed.
KIVI_BASE_URL=
# 32-byte key, base64 (generate: openssl rand -base64 32). Encrypts each store's Kivi token at
# rest (AES-256-GCM). It MUST be identical in the web app and the kivi-sync worker. Missing or
# invalid => pairing fails closed. Never commit it; back it up: losing it forces re-pairing.
KIVI_TOKEN_ENCRYPTION_KEY=
# Mirrors the worker deployment flag for the integrations panel; not a worker health probe.
KIVI_NOTIFICATIONS_ENABLED=false
