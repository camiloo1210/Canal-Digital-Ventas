# ==============================================================================
# CANAL DIGITAL VENTAS - WORKER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Usage instructions:
# 1. For initial setup only, copy this file to apps/worker/.env:
#    cp apps/worker/.env.example apps/worker/.env
#    If .env already exists, add missing settings without overwriting its credentials.
# 2. Fill in credentials for the same Supabase Cloud project used by the web app.
#    In Coolify, configure these settings in the service environment instead.
# 3. Quickstart commands from repository root:
#    - Start full Docker stack: pnpm messaging:up
#    - Follow worker and RabbitMQ logs: pnpm messaging:logs
#    - Stop Docker stack without removing volumes: pnpm messaging:down
#    - Run workers locally with Node.js: pnpm worker:outbox / pnpm worker:notifications
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. WORKER IMAGE BUILD
# ------------------------------------------------------------------------------
# Container protection is applied automatically by compose.rabbitmq.yml.
# pnpm messaging:up builds this default image if missing, then starts the stack.
# Coolify builds the same image from the repository; no GHCR token is required.
# Set Custom Build Command to: bash apps/worker/docker/build-coolify.sh
# The Compose image name is fixed; remove any old PAYMENTS_WORKER_IMAGE override.

# ------------------------------------------------------------------------------
# 1. RABBITMQ BROKER (Docker Container Initialization)
# ------------------------------------------------------------------------------
# Where to get this:
# - In LOCAL: You can choose any username and password (e.g., admin / admin123).
#   Docker will provision this user when initializing the container volume for the first time.
# - In PRODUCTION: Choose a strong, unique password for this Compose-managed broker.
#   Keep RABBITMQ_URL credentials consistent with these values. The defaults below
#   are development examples only. Changing them does not rotate an existing volume's user.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=canaldigital

# Optional host access through compose.rabbitmq.local.yml only:
# - 5673: AMQP port for local client/worker connections.
RABBITMQ_AMQP_PORT=5673

# ------------------------------------------------------------------------------
# 2. WORKER CONNECTION TO RABBITMQ
# ------------------------------------------------------------------------------
# Where to get this:
# - Running everything inside Docker Compose (pnpm messaging:up):
#   Use the Docker service hostname 'rabbitmq' and internal container port 5672:
#   RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/canaldigital?heartbeat=30
#
# - Running workers locally on host with Node.js (pnpm worker:outbox / notifications):
#   Use 127.0.0.1 and the exposed AMQP host port (5673):
#   RABBITMQ_URL=amqp://admin:admin123@127.0.0.1:5673/canaldigital?heartbeat=30
#
# NOTE: URL-encode credentials containing special characters (@, :, /, %, etc.).
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/canaldigital?heartbeat=30
RABBITMQ_QUEUE=canaldigital.notifications
OUTBOX_POLL_INTERVAL_MS=1000

# ------------------------------------------------------------------------------
# 3. NOTIFICATION DATABASE CONNECTIONS (Supabase Cloud)
# ------------------------------------------------------------------------------
# Use restricted PostgreSQL LOGINs provisioned for each service, with their own passwords.
# Obtain the host, port and database from the Supabase project's Connect dialog
# (direct connection or session pooler); retain the appropriate restricted username.
# URL-encode passwords. Require TLS with certificate verification, e.g. sslmode=verify-full.
# The Docker image already includes the Supabase CA certificate.
# Never use the administrative postgres LOGIN or a Supabase API key as a database URL.
# Blank values must be filled before starting Compose; no local Supabase is required.

# Connection for outbox-worker (requires membership in outbox_worker_role):
OUTBOX_DATABASE_URL=

# Connection for notification-worker (requires membership in notification_worker_role):
NOTIFICATION_DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. PAYMENT DATABASE CONNECTIONS (required by the full Compose stack)
# ------------------------------------------------------------------------------
# Each service gets only its own connection through Compose. Do not combine role
# memberships or reuse the web checkout/ingestion LOGINs for financial workers.

# payment-inbox: canaldigital_payment_worker, member of payment_worker_role.
PAYMENT_WORKER_DATABASE_URL=

# payment-relay: canaldigital_payment_relay, member of outbox_worker_role.
# Compose maps this setting to OUTBOX_DATABASE_URL inside payment-relay only.
PAYMENT_RELAY_DATABASE_URL=

# payment-orders: canaldigital_payment_domain, member of payment_order_domain_role.
PAYMENT_DOMAIN_DATABASE_URL=

# payment-dispatch: a separate restricted LOGIN with payment_worker_role membership.
# Provision that LOGIN if missing; Compose maps this to PAYMENT_WORKER_DATABASE_URL in that service.
PAYMENT_DISPATCH_DATABASE_URL=

# payment-egress: canaldigital_payment_egress, member of payment_egress_role.
PAYMENT_EGRESS_DATABASE_URL=

# payment-reconciliation: canaldigital_payment_reconciliation,
# member of payment_reconciliation_role.
PAYMENT_RECONCILIATION_DATABASE_URL=

# payment-retention: canaldigital_payment_retention, member of payment_retention_role.
PAYMENT_RETENTION_DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. PAYMENT PROVIDER AND INTERNAL EVIDENCE SERVICE
# ------------------------------------------------------------------------------
# Keep test while validating the deployed app. Publishing the app does not require
# switching to production payments. Match the web app, API key and database gateway configuration.
PAYMENTS_ENVIRONMENT=test

# Secret: Lemon Squeezy API key for the selected environment and store.
# Used only by payment-dispatch (refund requests) and payment-egress (provider evidence).
# Store/variant IDs belong to web checkout configuration, not these workers.
LEMON_SQUEEZY_API_KEY=

# Polling interval in milliseconds (100..60000); 1000 is the current default.
PAYMENT_INBOX_POLL_INTERVAL_MS=1000
PAYMENT_DOMAIN_QUEUE=canaldigital.payments.domain

# Internal loopback HTTP service shared by payment-egress and payment-reconciliation.
# Do not publish this port or configure a public Coolify domain for it.
PAYMENT_EGRESS_PORT=8090
# Secret shared only by those two services: 64 lowercase hexadecimal characters.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYMENT_EGRESS_TOKEN=

# Webhook verification uses the secret already stored in Supabase Vault.
# Do not add a webhook signing secret, administrative database URL, or backup key here.

# ------------------------------------------------------------------------------
# 6. SMTP SERVER (Google Workspace / Gmail)
# ------------------------------------------------------------------------------
# Where to get this:
# - SMTP_HOST:
#   * Standard Gmail or Google Workspace accounts: smtp.gmail.com
#   * Corporate relay configured in Google Workspace Admin: smtp-relay.gmail.com
# - SMTP_PORT: 587 (with STARTTLS: SMTP_SECURE=false) or 465 (with SSL: SMTP_SECURE=true)
# - SMTP_FROM_EMAIL: Authorized sender email (e.g., notificaciones@kirokusolutions.com).
# - SMTP_USER: Full email address of the Google account.
# - SMTP_PASSWORD: IMPORTANT! DO NOT use your standard Google password.
#   You must generate a 16-character "App Password":
#   1. Go to your Google Account -> Security (with 2-Step Verification enabled).
#   2. Navigate to: https://myaccount.google.com/apppasswords
#   3. Create an app password for "Canal Digital" and paste it here (without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_LOCALE=es
# Public web origin used by email buttons. HTTPS in production; no trailing path.
# Example: https://ventas.example.com. Blank omits buttons rather than guessing a domain.
NOTIFICATION_APP_URL=
