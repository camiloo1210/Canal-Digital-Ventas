# Supabase .env 
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Database url
DATABASE_URL=your_database_url_here

# Lemon Squeezy: keep UI off until Cloud migrations, financial workers and test acceptance pass.
PAYMENTS_CHECKOUT_UI_ENABLED=false
PAYMENTS_ENVIRONMENT=test
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
# Checkout confirmation and receipt buttons return to this app URL.
# Set your public HTTPS domain in production. Vercel system URLs are used if omitted.
PAYMENT_CHECKOUT_RETURN_URL=http://localhost:3000/
# Restricted LOGINs, never the administrative DATABASE_URL. Use TLS and URL-encoded passwords.
PAYMENT_CHECKOUT_DATABASE_URL=
PAYMENT_INGESTION_DATABASE_URL=
# Store, currency and webhook secret reference are provisioned in core.gateway_credentials.
# The webhook secret itself lives in Supabase Vault, not in NEXT_PUBLIC variables.

# Kivi catalog connector (platform-wide, set ONCE by the operator; stores never touch these).
# Public https origin of Kivi, no path. Owners pair their store from Dashboard > Integrations
# with a one-time code, so no per-store variable or URL is ever needed.
KIVI_BASE_URL=
# 32-byte key, base64 (generate: openssl rand -base64 32). Encrypts each store's Kivi token at
# rest (AES-256-GCM). It MUST be identical in the web app and the kivi-sync worker. Missing or
# invalid => pairing fails closed. Never commit it; back it up: losing it forces re-pairing.
KIVI_TOKEN_ENCRYPTION_KEY=
# Mirrors the worker deployment flag for the integrations panel; not a worker health probe.
KIVI_NOTIFICATIONS_ENABLED=false

# Production always enforces mutation/auth limits. Configure Redis and the key before deployment.
# This flag enables the same protection during local development.
RATE_LIMIT_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public catalog cache TTL (5-300 seconds; default 15).
CATALOG_CACHE_TTL_SECONDS=15
# Random secret of at least 32 characters; identical across instances of an environment.
RATE_LIMIT_KEY_SECRET=
# Self-hosted only: ingress must overwrite x-forwarded-for with ONE client IP and inject
# x-cdv-proxy-secret with this random 32+ character secret. Never forward client-supplied values.
# Without authenticated ingress, production mutations fail closed (503); reads/webhooks stay available.
RATE_LIMIT_PROXY_SECRET=
# Server-only Sentry DSN; security signals only, no browser SDK or tracing.
SENTRY_DSN=

# Supabase service role key. SERVER-ONLY secret: never prefix with NEXT_PUBLIC, never commit it.
# Used to create invitation accounts with a generated sign-in email (GENERATED_EMAIL mode): those
# addresses cannot receive mail, so the user must be created already confirmed. If unset, the app
# falls back to a normal sign up, which only works when Supabase email confirmations are disabled;
# otherwise generated-email invitations fail with a clear message.
SUPABASE_SERVICE_ROLE_KEY=

# AI advisor for Business Intelligence (server only, never NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# FedEx sandbox only. Configure server-side for a test-data deployment.
TRACKING_SANDBOX_ENABLED=false
TRACKING_DEPLOYMENT_ID=
TRACKING_TENANT_REFS_JSON=
# Automatic FedEx sandbox shipment creation. Exactly `true` (plus a valid sandbox tracking config
# above) queues a job when an order moves to PROCESSING. Set it ONLY in the same deployment that
# runs the shipment-creation worker; otherwise jobs would be queued that nothing consumes.
SHIPMENT_CREATION_SANDBOX_ENABLED=false
# Optional identity of an actual production database, used only for isolation checks.
PRODUCTION_DATABASE_URL=
