{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@canaldigital/packages/core/cart-pricing": [
        "../../packages/core/src/features/carts/application/services/cart-quote.ts"
      ],
      "@canaldigital/packages/core/money-format": [
        "../../packages/core/src/features/shared/domain/money-format.ts"
      ],
      "@canaldigital/packages/core/money-limits": [
        "../../packages/core/src/features/shared/domain/money-limits.ts"
      ],
      "@/dashboard/*": ["../../packages/core/src/features/dashboard/*"],
      "@/*": ["./*"],
      "@/shared/*": ["../../packages/core/src/features/shared/*"],
      "@/products/*": ["../../packages/core/src/features/products/*"],
      "@/categories/*": ["../../packages/core/src/features/categories/*"],
      "@/orders/*": ["../../packages/core/src/features/orders/*"],
      "@/payments/*": ["../../packages/core/src/features/payments/*"],
      "@/iam/*": ["../../packages/core/src/features/iam/*"],
      "@/tenants/*": ["../../packages/core/src/features/tenants/*"],
      "@/sales/*": ["../../packages/core/src/features/sales/*"],
      "@/notifications/*": ["../../packages/core/src/features/notifications/*"],
      "@/kivi/*": ["../../packages/core/src/features/kivi/*"],
      "@/carts/*": ["../../packages/core/src/features/carts/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
