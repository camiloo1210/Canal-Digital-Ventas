# Copy to apps/worker/.env and fill credentials before starting the stack.
# From the repository root: pnpm messaging:up
# Follow logs: pnpm messaging:logs. Stop without deleting volumes: pnpm messaging:down
# PostgreSQL migrations and passwords are provisioned separately, never at container startup.

# Broker initialization. Changing these values does not rotate users in an existing volume.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=canaldigital
RABBITMQ_BIND_ADDRESS=127.0.0.1
# Host ports differ from ema3; connections between containers still use port 5672.
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# Compose workers use the service hostname rabbitmq, not localhost.
# Example: amqp://USER:URL_ENCODED_PASSWORD@rabbitmq:5672/canaldigital?heartbeat=30
# Match broker user/password/vhost above. URL-encode credentials containing special characters.
# For workers started directly with pnpm, replace rabbitmq with the broker host.
RABBITMQ_URL=
RABBITMQ_QUEUE=canaldigital.notifications
OUTBOX_POLL_INTERVAL_MS=1000

# Dedicated PostgreSQL LOGIN with membership in outbox_worker_role.
# Use a direct connection or session pooler, not the Supabase HTTP service-role key.
# Example: postgresql://canaldigital_outbox:PASSWORD@DB_HOST:5432/postgres?sslmode=verify-full
OUTBOX_DATABASE_URL=

# Separate PostgreSQL LOGIN with membership in notification_worker_role.
# Point both URLs to the same production database used by the web application.
NOTIFICATION_DATABASE_URL=

# Same SMTP protocol as ema3: Gmail Workspace relay, optional paired credentials.
# Configure the Kiroku Solutions sender and credentials through the environment.
# SMTP_HOST defaults to smtp-relay.gmail.com when blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_LOCALE=es
