# ==============================================================================
# CANAL DIGITAL VENTAS - WORKER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Usage instructions:
# 1. Copy this file to apps/worker/.env:
#    cp apps/worker/.env.example apps/worker/.env
# 2. Fill in credentials according to your environment (local or production).
# 3. Quickstart commands from repository root:
#    - Start full Docker stack: pnpm messaging:up
#    - Follow worker and RabbitMQ logs: pnpm messaging:logs
#    - Stop Docker stack without removing volumes: pnpm messaging:down
#    - Run workers locally with Node.js: pnpm worker:outbox / pnpm worker:notifications
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RABBITMQ BROKER (Docker Container Initialization)
# ------------------------------------------------------------------------------
# Where to get this:
# - In LOCAL: You can choose any username and password (e.g., admin / admin123).
#   Docker will provision this user when initializing the container volume for the first time.
# - In PRODUCTION: Use the credentials from your managed broker instance (e.g., CloudAMQP).
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=canaldigital
RABBITMQ_BIND_ADDRESS=127.0.0.1

# Ports exposed on the Host:
# - 5673: AMQP port for local client/worker connections.
# - 15673: RabbitMQ management web UI (http://localhost:15673).
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# ------------------------------------------------------------------------------
# 2. WORKER CONNECTION TO RABBITMQ
# ------------------------------------------------------------------------------
# Where to get this:
# - Running everything inside Docker Compose (pnpm messaging:up):
#   Use the Docker service hostname 'rabbitmq' and internal container port 5672:
#   RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/canaldigital?heartbeat=30
#
# - Running workers locally on host with Node.js (pnpm worker:outbox / notifications):
#   Use 127.0.0.1 and the exposed AMQP host port (5673):
#   RABBITMQ_URL=amqp://admin:admin123@127.0.0.1:5673/canaldigital?heartbeat=30
#
# NOTE: URL-encode credentials containing special characters (@, :, /, %, etc.).
RABBITMQ_URL=amqp://admin:admin123@127.0.0.1:5673/canaldigital?heartbeat=30
RABBITMQ_QUEUE=canaldigital.notifications
OUTBOX_POLL_INTERVAL_MS=1000

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Where to get this:
# - In LOCAL (Supabase CLI / Docker):
#   The default local Supabase Postgres port is 54322 (see supabase/config.toml).
#   Before connecting, set passwords for the migration-provisioned roles in Postgres:
#     ALTER ROLE canaldigital_outbox WITH PASSWORD 'postgres';
#     ALTER ROLE canaldigital_notifications WITH PASSWORD 'postgres';
#   Local example: postgresql://canaldigital_outbox:postgres@127.0.0.1:54322/postgres
#
# - In PRODUCTION (Supabase Cloud / RDS):
#   Obtain the connection URI from the Supabase dashboard:
#   Project Settings -> Database -> Connection string (URI with direct connection or session pooler).
#   Ensure connection roles have outbox_worker_role and notification_worker_role memberships.

# Connection for outbox-worker (requires membership in outbox_worker_role):
OUTBOX_DATABASE_URL=postgresql://canaldigital_outbox:postgres@127.0.0.1:54322/postgres

# Connection for notification-worker (requires membership in notification_worker_role):
NOTIFICATION_DATABASE_URL=postgresql://canaldigital_notifications:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 4. SMTP SERVER (Google Workspace / Gmail)
# ------------------------------------------------------------------------------
# Where to get this:
# - SMTP_HOST:
#   * Standard Gmail or Google Workspace accounts: smtp.gmail.com
#   * Corporate relay configured in Google Workspace Admin: smtp-relay.gmail.com
# - SMTP_PORT: 587 (with STARTTLS: SMTP_SECURE=false) or 465 (with SSL: SMTP_SECURE=true)
# - SMTP_FROM_EMAIL: Authorized sender email (e.g., notificaciones@kirokusolutions.com).
# - SMTP_USER: Full email address of the Google account.
# - SMTP_PASSWORD: IMPORTANT! DO NOT use your standard Google password.
#   You must generate a 16-character "App Password":
#   1. Go to your Google Account -> Security (with 2-Step Verification enabled).
#   2. Navigate to: https://myaccount.google.com/apppasswords
#   3. Create an app password for "Canal Digital" and paste it here (without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_LOCALE=es
