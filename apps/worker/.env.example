# Copy to apps/worker/.env and fill credentials before starting the stack.
# From the repository root: pnpm messaging:up
# Follow logs: pnpm messaging:logs. Stop without deleting volumes: pnpm messaging:down
# Complete Gmail configuration before starting notification-worker.
# Queue-only startup: docker compose --env-file apps/worker/.env -f compose.rabbitmq.yml up -d rabbitmq outbox-worker
# PostgreSQL migrations and passwords are provisioned separately, never at container startup.

# Broker initialization. Changing these values does not rotate users in an existing volume.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=canaldigital
# No host ports in the production Compose. Optional local UI access:
# docker compose --env-file apps/worker/.env -f compose.rabbitmq.yml -f compose.rabbitmq.local.yml up -d
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# Compose workers use the service hostname rabbitmq, not localhost.
# Example: amqp://USER:URL_ENCODED_PASSWORD@rabbitmq:5672/canaldigital?heartbeat=30
# Match broker user/password/vhost above. URL-encode credentials containing special characters.
# For workers started directly with pnpm, replace rabbitmq with the broker host.
# Coolify: use Raw Compose / deploy file as-is; do not attach public domains
# or shared proxy networks. network_mode is required for private payment evidence.
RABBITMQ_URL=
RABBITMQ_QUEUE=canaldigital.notifications
OUTBOX_POLL_INTERVAL_MS=1000

# Dedicated PostgreSQL LOGIN with membership in outbox_worker_role.
# Use a direct connection or session pooler, not the Supabase HTTP service-role key.
# Example: postgresql://canaldigital_outbox:PASSWORD@DB_HOST:5432/postgres?sslmode=verify-full
# The image defaults to verified TLS and includes Supabase's public CA.
# Every DATABASE_URL must omit sslmode or use sslmode=verify-full; do not disable TLS.
OUTBOX_DATABASE_URL=

# Separate PostgreSQL LOGIN with membership in notification_worker_role.
# Point both URLs to the same production database used by the web application.
NOTIFICATION_DATABASE_URL=

# Separate restricted LOGIN, member only of payment_worker_role. Never use DATABASE_URL.
PAYMENT_WORKER_DATABASE_URL=
PAYMENT_DISPATCH_DATABASE_URL=
PAYMENT_RELAY_DATABASE_URL=
PAYMENT_INBOX_POLL_INTERVAL_MS=1000
PAYMENT_DOMAIN_DATABASE_URL=
PAYMENT_DOMAIN_QUEUE=canaldigital.payments.domain
PAYMENT_RECONCILIATION_DATABASE_URL=
PAYMENT_EGRESS_DATABASE_URL=
PAYMENT_RETENTION_DATABASE_URL=
PAYMENT_EGRESS_PORT=8090
PAYMENT_EGRESS_TOKEN=
PAYMENTS_ENVIRONMENT=test
LEMON_SQUEEZY_API_KEY=
# Compose injects only the variables needed by each process.
# The provider API key is available only to dispatch and egress containers.

# Gmail: use the same address for SMTP_USER and SMTP_FROM_EMAIL.
# SMTP_PASSWORD is a Google app password, never the normal account password.
# Generate at https://myaccount.google.com/apppasswords and enter without spaces.
# Google Workspace relay can be configured explicitly with its own host/auth policy.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_LOCALE=es
