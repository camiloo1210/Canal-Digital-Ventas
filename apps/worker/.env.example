# Dedicated PostgreSQL LOGIN with membership in outbox_worker_role.
# Use a direct connection or session pooler, not the Supabase HTTP service-role key.
OUTBOX_DATABASE_URL=postgresql://canaldigital_outbox:replace-me@localhost:54322/postgres
RABBITMQ_URL=amqp://canaldigital:canaldigital-local@localhost:5672?heartbeat=30
RABBITMQ_QUEUE=canaldigital.events
OUTBOX_POLL_INTERVAL_MS=1000
